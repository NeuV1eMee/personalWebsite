etadataOutlet\",\"children\":\"$@7\"}]}]]}],{},null,false,false]},null,false,false]},null,false,false]},null,false,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L8\",null,{\"children\":\"$L9\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$La\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.Metadata\",\"children\":\"$Lb\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"S\":true}\nd:I[22016,[\"/_next/static/chunks/7c92e96509cd355e.js\"],\"\"]\ne:T5ca,My mom asked me why I suddenly decided not to start working right after graduation.I told her:\n\n“Why not? I love the feeling of having options.I want to get into Big Tech—the money is great. But then again, maybe not—it’s exhausting, and I’d probably lose my hair to the grind. I want to be a Product Manager; the sense of achievement from building something is huge. But then again, maybe not—dealing with a hundred different personalities and playing the peacemaker sounds like a drag.\n\nI want to make films, maybe join a top-tier production house like MediaStorm. I want to be a creator, like the guys at Speedster. I even want to build rockets from scratch in a backyard workshop.\n\nI want to be a photographer, join a film crew, drive race cars for a factory team, or be a designer. I want to make music—play guitar in a dive bar and sing whatever song I’m obsessed with lately, not giving a damn whether the crowd is listening or not.\n\nI just suddenly realized: if I finish a Master’s degree and just start climbing the corporate ladder, my life is basically set in stone. Sure, I’ll make plenty of money and settle down in a big city, but I’ll lose my choices. The cost of turning back will be too high. Kids need school, and a wife might be shouting about divorce every time she’s unhappy. Good God!\n\nI just want to grab it all while I’m young: the best views, the best girls, the best version of myself, and the best opportunities.”\n\nMy Mom: 😮4:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-[#060606] text-neutral-400 font-light selection:bg-white selection:text-black pb-32\",\"children\":[[\"$\",\"header\",null,{\"className\":\"fixed top-0 left-0 right-0 z-40 p-6 grid grid-cols-3 items-center bg-[#060606]/80 backdrop-blur-sm border-b border-neutral-900/50\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-start\",\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/about\",\"children\":[\"$\",\"span\",null,{\"className\":\"group relative inline-flex items-center justify-center px-4 py-2 font-sans transition-colors duration-300 text-sm text-neutral-500 hover:text-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 opacity-50 group-hover:opacity-100 transition-opacity\",\"children\":\"[\"}],[\"$\",\"span\",null,{\"className\":\"tracking-widest uppercase\",\"children\":\"< Back\"}],[\"$\",\"span\",null,{\"className\":\"ml-2 opacity-50 group-hover:opacity-100 transition-opacity\",\"children\":\"]\"}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"flex justify-center\",\"children\":[\"$\",\"h1\",null,{\"className\":\"text-[10px] md:text-xs font-normal tracking-[0.4em] text-neutral-500 uppercase\",\"children\":\"Monologue\"}]}],[\"$\",\"div\",null,{\"className\":\"flex justify-end invisible md:visible\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-16\"}]}]]}],[\"$\",\"main\",null,{\"className\":\"pt-48 px-6 md:px-12 max-w-4xl mx-auto\",\"children\":[[\"$\",\"header\",null,{\"className\":\"mb-24 space-y-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-[10px] font-mono text-neutral-600 tracking-[0.3em]\",\"children\":\"FEBRUARY 24, 2026\"}],[\"$\",\"h1\",null,{\"className\":\"text-4xl md:text-6xl font-light tracking-tight text-neutral-100 leading-tight uppercase\",\"children\":\"The future is yet to come\"}],[\"$\",\"div\",null,{\"className\":\"w-12 h-px bg-neutral-800\"}]]}],[\"$\",\"article\",null,{\"className\":\"prose prose-invert max-