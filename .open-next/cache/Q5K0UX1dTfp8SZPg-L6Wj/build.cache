16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"ViewportBoundary\"]\n14:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"MetadataBoundary\"]\na:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/98d26d0678a59e66.js\",\"async\":true,\"nonce\":\"$undefined\"}]\nb:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/9006a9dbed1389eb.js\",\"async\":true,\"nonce\":\"$undefined\"}]\nc:[\"$\",\"$Lf\",null,{\"children\":[\"$\",\"$10\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@11\"}]}]\nd:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L14\",null,{\"children\":[\"$\",\"$10\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L15\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n16:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\n11:null\n15:[[\"$\",\"title\",\"0\",{\"children\":\"Personal Portfolio\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Crafting code, capturing light, and making some noise.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.0b3bf435.ico\",\"sizes\":\"256x256\",\"type\":\"image/x-icon\"}],[\"$\",\"$L16\",\"3\",{}]]\n","/build/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[22016,[\"/_next/static/chunks/98d26d0678a59e66.js\",\"/_next/static/chunks/9006a9dbed1389eb.js\"],\"\"]\n3:I[26383,[\"/_next/static/chunks/98d26d0678a59e66.js\",\"/_next/static/chunks/9006a9dbed1389eb.js\"],\"BuildClient\"]\nb:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"OutletBoundary\"]\nc:\"$Sreact.suspense\"\n4:T699,The Philosophy: Brutalist Minimalism & Visual Silence\nIn a digital landscape filled with saturated colors and over-engineered interactions, this portfolio was built as an exercise in restraint. The design system follows a strict Black & White palette, where every pixel is intentional. Color is treated as a premium resource, only appearing when the user actively engages with a project or photograph. The use of bracketed UI elements and monospaced typography pays homage to terminal aesthetics while maintaining a premium, high-fashion editorial feel.\n\nThe Architecture: Dynamic, Server-First, and Scalable\nThe technical foundation is built on Next.js 16 and the App Router, prioritizing Server Components to ensure lightning-fast load times despite the use of high-resolution video backgrounds. Instead of a traditional database, the entire site is powered by a Git-based headless CMS (Decap CMS). Every project, photograph, and journal entry is stored as flat JSON files within the repository. This architecture ensures the site is 100% data-driven and manageable via a local admin interface, while remaining exceptionally cost-effective and portable.\n\nThe Experience: Cinematic Motion & Grain\nTo avoid the static nature of traditional portfolios, I implemented a custom background system that loops grainy, B&W visual fragments. A cinematic \"dip-to-black\" transition logic was built into the video engine to pre-emptively fade the background 0.8s before a video ends, ensuring a seamless loop. Combined with a global CSS grain overlay and scroll-triggered grayscale-to-color transitions, the site feels \"grounded\" and alive—reflecting the physical textures of film and analog noise.5:T6f3,The Mission: Analog Soul, Zero Barrier\nWhile film photography is seeing a massive resurgence, the \"entry fee\"—from skyrocketing gear prices to the cost of every shutter click—is a major hurdle for casual creators. Darkroom Studio was built to dismantle these barriers. It isn't just a camera app; it is an educational sandbox that brings the intentionality of analog to the iPhone. By teaching users the relationship between different camera bodies, film stocks, and lenses, the project provides a risk-free environment to learn the craft without the financial stakes of physical film.\n\nThe Simulation: Demystifying the Darkroom\nThe core of the experience lies in its commitment to the \"black box\" of the darkroom. Most digital users have no idea what happens after they drop off a roll of film, so the app visualizes the chemistry of development and the enlarging process. Once a \"roll\" is finished, the app simulates the chemical processing in real-time. This includes an \"Enforced Patience\" mechanic—removing the skip button and forcing users to wait for their results—which restores the weight and commitment to every frame captured.\n\nThe Build: Native Precision and Authentic Color\nMoving away from game-engine wrappers, I developed the prototype entirely in Swift to leverage native iOS performance and high-end camera APIs. To ensure the aesthetic was as authentic as the workflow, I integrated open-source film LUTs (Look-Up Tables) to drive the color science. This allows the app to replicate the specific color shifts and tonal curves of legendary film stocks with mathematical accuracy. By combining native performance with established color science, Darkroom Studio proves that the essence of film isn't just in the grain, but in the methodology and the wait.6:T590,@Pitt's Game 4 Social Impact 2025\n\nOreo is a mind-bending 3D sci-fi puzzle-adventure that invites players into a meticulously crafted world of retro-futurism. The game’s aesthetic strikes a unique balance between the tactile grit of vintage surveillance technology and the ethereal glow of sleek holographic displays, creating an atmosphere that feels both nostalgic and hauntingly advanced. \n\n Born from the high-pressure constraints of a 48-hour game jam, Oreo pushes the boundaries of traditional puzzle design by forcing players to truly think outside the box. The experience centers on a reality-bending core mechanic: the ability to jump between two distinct scenes to overcome environmental obstacles. What appears to be a dead-end in one world often holds the key to progression in the other, requiring players to synchronize their actions across different layers of reality.\n\nAs you navigate through its atmospheric corridors using fluid, floating movement, you must interact with terminal systems and monitor CCTV feeds to piece together solutions. Whether you are managing power grids or navigating through portals, Oreo rewards lateral thinking and keen observation. It is a polished exploration of space and logic, delivering a complete, stylish, and intellectually stimulating experience within a compact, high-tech package.\n\nCo-worked with: Peter Ju, Alina Yue, Zilin Wang, Marshall Fan, Sam Gao, Yishui Sun7:T57c,SleePurr transforms sleep health into a delightful experience by reflecting a user's sleep quality through the mood and status of a virtual cat companion. Built with SwiftUI and Supabase, the application employs a sophisticated \"Slow Loop\" AI architecture to analyze 10 dimensions of sleep data and generate personalized, empathetic dialogues that help users identify habits like caffeine intake or screen time that affect their rest. By combining this AI core with a 7-day social competition system inspired by Apple Fitness, SleePurr bridges the gap between raw health metrics and actionable behavior change, offering a resilient and engaging platform for improving long-term sleep hygiene.\n\nThe application is built on a modern, scalable stack centered around SwiftUI for a native iOS frontend and HealthKit for robust health data integration. The backend infrastructure utilizes Supabase, leveraging PostgreSQL with Row Level Security (RLS) for data integrity and TypeScript-based Edge Functions (Deno) for performant serverless logic. Advanced AI interactions are orchestrated through OpenRouter, providing access to various Large Language Models (LLMs) such as GPT-4 and Claude. The project also employs a modularized architecture via Swift Package Manager (SPM) and maintains high code quality through a custom Deno-based testing framework and a structured migration system for database evolution.0:{\"buildId\":\"Q5K0UX1dTfp8SZPg-L6Wj\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-black text-neutral-400 selection:bg-white selection:text-black font-light pb-20\",\"children\":[[\"$\",\"header\",null,{\"className\":\"fixed top-0 left-0 right-0 z-40 p-6 grid grid-cols-3 items-center bg-black/80 backdrop-blur-sm border-b border-neutral-900/50\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-start\",\"children\":[\"$\",\"$L2\",null,{\"href\":\"/\",\"children\":[\"$\",\"span\",null,{\"className\":\"group relative inline-flex items-center justify-center px-4 py-2 font-sans transition-colors duration-300 text-sm text-neutral-500 hover:text-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-2 opacity-50 group-hover:opacity-100 transition-opacity\",\"children\":\"[\"}],[\"$\",\"span\",null,{\"className\":\"tracking-widest uppercase\",\"children\":\"< Back\"}],[\"$\",\"span\",null,{\"className\":\"ml-2 opacity-50 group-hover:opacity-100 transition-opacity\",\"children\":\"]\"}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"flex justify-center\",\"children\":[\"$\",\"h1\",null,{\"className\":\"text-sm md:text-base font-normal tracking-[0.3em] text-neutral-300 uppercase\",\"children\":\"Projects\"}]}],[\"$\",\"div\",null,{\"className\":\"flex justify-end\",\"children\":[\"$\",\"$L2\",null,{\"href\":\"/photos/uploads/resume_tech_eng.pdf\",\"children\":[\"$\",\"span\",null,{\"className\":\"group relative inline-flex items-center justify-center px-4 py-2 font-sans transition-colors duration-300 text-sm text-neutral-500 hover:text-white\",\"children\":[[\"$\",\"span\",null,{\"className\":\