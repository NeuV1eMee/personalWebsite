{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": "build-assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  }
}
